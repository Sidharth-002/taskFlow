# Copy this file to .env and fill in real values for local development.
# .env is git-ignored - never commit actual secrets.

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL ---
# Mapped to 5433 on the host to avoid clashing with a locally installed
# PostgreSQL service that may already be bound to 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=flowdesk
DB_USERNAME=flowdesk
DB_PASSWORD=flowdesk

# --- Redis (introduced in Phase 7) ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Kafka (introduced in Phase 8) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT (introduced in Phase 3) ---
# JWT_SECRET=
# JWT_ACCESS_TOKEN_TTL_MINUTES=15
# JWT_REFRESH_TOKEN_TTL_DAYS=7
