# Copy this file to .env and fill in real values for local development.
# .env is git-ignored - never commit actual secrets.

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL ---
# Mapped to 5433 on the host to avoid clashing with a locally installed
# PostgreSQL service that may already be bound to 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=flowdesk
DB_USERNAME=flowdesk
DB_PASSWORD=flowdesk

# --- Redis ---
# Caching (CacheConfig) and the distributed auth rate limiter both use
# this. Mapped to 6380 on the host to avoid clashing with a locally
# installed Redis service that may already be bound to 6379 (same
# reasoning as Postgres's 5433 above). No password locally -
# docker-compose's redis service doesn't set one; set REDIS_PASSWORD in
# any shared/production environment.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# --- Kafka ---
# Ticket domain events, published after transaction commit and consumed
# independently by the notification and audit modules (see
# ticket.event.TicketEventKafkaRelay). 9092 is free by default on this
# machine, unlike Postgres/Redis's default ports, so no remapping needed -
# adjust KAFKA_PORT here and in docker-compose.yml together if it clashes
# with a local Kafka install.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# --- JWT ---
# Dev has a built-in fallback secret (see application-dev.yml), so this is
# optional locally. Required in prod - the app fails to start without it.
# Generate a real one with: openssl rand -base64 48
# JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
